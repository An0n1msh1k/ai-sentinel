#!/usr/bin/env bash
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Interactive mode if no args provided
if [ "$#" -lt 1 ]; then
    echo "--- AI Sentinel ---"
    read -p "Task: " PROMPT
    [ -z "$PROMPT" ] && echo "Aborted." && exit 1
    read -p "Files (leave blank for auto): " FILES_ARGS
else
    PROMPT="$1"
    shift
    FILES_ARGS="$@"
fi

CONFIG_MODEL=$(python -c "
import sys
try:
    sys.path.append('$DIR')
    from config import ACTOR_MODEL
    print(ACTOR_MODEL)
except Exception:
    print('groq/llama-3.3-70b-versatile')
")
MODEL="${AIDER_MODEL:-$CONFIG_MODEL}"

echo "[1/3] Coder ($MODEL)..."
if ! aider --model "$MODEL" --yes --map-tokens 0 -m "$PROMPT" $FILES_ARGS; then
    echo "[!] Coder failed. Rolling back..."
    [ -n "$FILES_ARGS" ] && git restore $FILES_ARGS || true
    exit 1
fi

ATTEMPT=1
MAX_RETRIES=2

while [ $ATTEMPT -le $MAX_RETRIES ]; do
    echo "[2/3] Linter (Attempt $ATTEMPT/$MAX_RETRIES)..."
    if "$DIR/sentinel-check" > /tmp/sentinel_lint 2>&1; then
        echo "[+] Linter passed."
        rm -f /tmp/sentinel_lint
        
        echo "[3/3] Critic..."
        if "$DIR/sentinel" "Verify task: $PROMPT" -d -s code_logic; then
            echo "[+] Success. Ready to commit."
            exit 0
        else
            echo "[!] Critic rejected changes."
            exit 1
        fi
    else
        LINT_ERRORS=$(cat /tmp/sentinel_lint)
        echo "[!] Linter failed. Fixing..."
        if ! aider --model "$MODEL" --yes --map-tokens 0 -m "Fix linter errors: $LINT_ERRORS" $FILES_ARGS; then
             echo "[!] Fix failed. Rolling back..."
             [ -n "$FILES_ARGS" ] && git restore $FILES_ARGS || true
             exit 1
        fi
        ATTEMPT=$((ATTEMPT + 1))
    fi
done

echo "[!] Max retries reached. Rolling back..."
[ -n "$FILES_ARGS" ] && git restore $FILES_ARGS || true
rm -f /tmp/sentinel_lint
exit 1
